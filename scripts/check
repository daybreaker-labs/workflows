#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

failed=()
step() {
  local name=$1 code=0 start=''; shift
  echo "== $name"
  command -v daybreaker-otel >/dev/null 2>&1 && start=$(python3 -c 'import time; print(time.time_ns())')
  "$@" || code=$?
  [ "$code" -eq 0 ] || failed+=("$name")
  if [ -n "$start" ]; then
    local error=()
    [ "$code" -eq 0 ] || error=(--error)
    daybreaker-otel span --service local-gate --name "$name" --start-ns "$start" "${error[@]}" \
      --attr "process.exit.code=$code" || true
  fi
}
zizmor_version=$(sed -nE 's#.*zizmor/releases/download/v([0-9.]+)/.*#\1#p' .github/workflows/checks.yml | head -n 1)

step "workflow program tests" python3 -m unittest discover -s scripts/tests
step "actionlint" actionlint
step "zizmor (offline)" uvx -q "zizmor@$zizmor_version" --offline --persona=regular .

if [ ${#failed[@]} -gt 0 ]; then
  printf 'local gate failed: %s\n' "${failed[*]}" >&2
  exit 1
fi
echo "local gate passed"
